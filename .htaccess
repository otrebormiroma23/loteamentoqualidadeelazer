# =========================================================
#  Santa Bárbara Resort — .htaccess  (HostGator / Apache)
#  Arquivo oculto: ative "Mostrar arquivos ocultos" no File Manager
# =========================================================

# 1) Padrão do site + codificação
DirectoryIndex index.html
AddDefaultCharset UTF-8
Options -Indexes -MultiViews

# 2) HTTPS + segurança básica
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forçar HTTPS (ative também o AutoSSL em cPanel > SSL/TLS)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Escolha UMA das opções abaixo depois de definir o domínio ---
  # Forçar COM www:
  # RewriteCond %{HTTP_HOST} ^exemplo\.com\.br$ [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Forçar SEM www:
  # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  # RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]

  # Bloquear o repositório Git, caso suba por FTP
  RewriteRule (^|/)\.git - [F,NC]
</IfModule>

# 3) Compressão (mod_deflate) — reduz o tráfego em ~70%
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# 4) Cache no navegador (mod_expires)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# 5) Cabeçalhos de segurança (mod_headers)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
